rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/config/admin)
        && get(/databases/$(database)/documents/config/admin).data.uid == request.auth.uid;
    }
    function own() {
      return signedIn() && request.resource.data.uid == request.auth.uid;
    }

    // 관리자 지정: 처음 한 번만 (아무도 없을 때)
    match /config/admin {
      allow read: if signedIn();
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/config/admin)
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 사용자 + 내 화장실 (나만 보기)
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow write: if signedIn() && request.auth.uid == uid;
      match /toilets/{id} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // 그룹 + 그룹 화장실
    // 방장: 그룹 관리 전부 · 부방장: 가입 수락·멤버 내보내기 · 멤버: 내 이름 바꾸기·나가기 · 총관리자: 최대 인원
    function groupMax() {
      return 'maxMembers' in resource.data ? resource.data.maxMembers
        : (exists(/databases/$(database)/documents/config/groups)
            ? get(/databases/$(database)/documents/config/groups).data.defaultMax : 10);
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function subsOf() { return 'subs' in resource.data ? resource.data.subs : []; }
    match /groups/{gid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && !('maxMembers' in request.resource.data)
        && (!('subs' in request.resource.data) || request.resource.data.subs == []);
      allow update: if signedIn() && (
        // 방장: 최대 인원·방장 바꾸기 빼고 전부, 인원 제한 지키기
        (resource.data.owner == request.auth.uid
          && !changed().hasAny(['maxMembers', 'owner'])
          && request.resource.data.members.size() <= groupMax())
        // 부방장: 멤버·이름만, 방장·부방장은 못 내보냄, 인원 제한 지키기
        || (request.auth.uid in subsOf()
          && changed().hasOnly(['members', 'names'])
          && resource.data.owner in request.resource.data.members
          && request.resource.data.members.hasAll(subsOf())
          && request.resource.data.members.size() <= groupMax())
        // 멤버: 나가기 (나만 빠짐)
        || (request.auth.uid in resource.data.members
          && changed().hasOnly(['members', 'subs'])
          && request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet()))
        // 멤버: 내 이름만 바꾸기
        || (request.auth.uid in resource.data.members
          && changed().hasOnly(['names'])
          && request.resource.data.names.diff('names' in resource.data ? resource.data.names : {}).affectedKeys().hasOnly([request.auth.uid]))
        // 총관리자: 최대 인원만
        || (isAdmin() && changed().hasOnly(['maxMembers']))
      );
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /toilets/{id} {
        allow read, write: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.members;
      }

      // 가입 요청: 본인이 보내고, 방장·부방장이 보고 지움
      match /requests/{uid} {
        function g() { return get(/databases/$(database)/documents/groups/$(gid)).data; }
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'at']);
        allow read, delete: if signedIn() && (request.auth.uid == uid
          || g().owner == request.auth.uid
          || request.auth.uid in ('subs' in g() ? g().subs : []));
      }
    }

    // 공중화장실 (관리자만 업데이트, 누구나 보기)
    match /publicCells/{cell} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 제휴 가게 (관리자만 등록·수정, 누구나 보기)
    match /partners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 제휴 가게 통계 (누구나 횟수만 늘릴 수 있음, 관리자만 보기)
    match /partnerStats/{id} {
      function okKeys() {
        return request.resource.data.keys().hasOnly(['views', 'opens', 'routes', 'visits', 'coupons', 'partnerId', 'month'])
          && exists(/databases/$(database)/documents/partners/$(request.resource.data.partnerId));
      }
      function notLess(k) {
        return !(k in resource.data) || (request.resource.data[k] is int && request.resource.data[k] >= resource.data[k]);
      }
      allow read: if isAdmin();
      allow create: if okKeys();
      allow update: if okKeys() && notLess('views') && notLess('opens') && notLess('routes') && notLess('visits') && notLess('coupons');
      allow delete: if isAdmin();
    }

    // 앱 안 문의 (사용자 ↔ 운영자)
    match /inquiries/{uid} {
      allow read, write: if signedIn() && (request.auth.uid == uid || isAdmin());
      match /messages/{m} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow create: if signedIn()
          && request.resource.data.text is string && request.resource.data.text.size() <= 1000
          && ((request.auth.uid == uid && request.resource.data.from == 'user')
              || (isAdmin() && request.resource.data.from == 'admin'));
        allow delete: if isAdmin();
      }
    }

    // 사용불가 신고 · 다시 열림
    match /unavail/{id} {
      allow read: if true;
      allow create, update: if own();
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }
    match /status/{id} {
      allow read: if true;
      allow write: if signedIn();
    }

    // 상태 투표 (깨끗해요 · 보통 · 별로예요)
    match /votes/{id} {
      allow read: if true;
      allow create, update: if own();
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // 사용자 메모
    match /memos/{id} {
      allow read: if true;
      allow create: if own();
      allow update: if signedIn() && resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // 메모 신고 (관리자만 보기)
    match /memoReports/{id} {
      allow create: if own();
      allow read, delete: if isAdmin();
    }
  }
}
