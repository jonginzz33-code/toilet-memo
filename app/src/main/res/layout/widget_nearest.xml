<?xml version="1.0" encoding="utf-8"?>
<!-- 홈 화면 위젯 (세 칸): 위에 제목·새로고침, 아래 내 화장실 / 공중화장실 / 제휴 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout
    android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_gravity="top"
    android:orientation="vertical" android:padding="12dp"
    android:background="@drawable/widget_bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_title"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="11sp" android:textColor="#888780" android:textStyle="bold"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_refresh"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="⟳ 새로고침" android:textSize="13sp" android:textColor="#FFFFFF" android:textStyle="bold"
            android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp"
            android:background="@drawable/widget_refresh_bg" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="horizontal">

        <!-- 내 화장실 -->
        <LinearLayout android:id="@+id/w_mine"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginEnd="3dp" android:orientation="vertical" android:padding="9dp"
            android:background="@drawable/widget_card_mine">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🔒 내 화장실" android:textSize="10.5sp" android:textColor="#FFFFFF" android:textStyle="bold"
                android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="1dp" android:paddingBottom="1dp"
                android:background="@drawable/widget_tag_orange" />
            <TextView android:id="@+id/w_m_name"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:textSize="13sp" android:textColor="#2C2C2A" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_m_sub"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="#5F5E5A" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_m_pw"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                android:textSize="16sp" android:textColor="#2C2C2A" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/w_m_go"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="어플에서 길찾기" android:gravity="center" android:textSize="10.5sp" android:textColor="#2C2C2A" android:textStyle="bold"
                android:paddingTop="5dp" android:paddingBottom="5dp" android:background="@drawable/widget_btn_bg" />
        </LinearLayout>

        <!-- 공중화장실 -->
        <LinearLayout android:id="@+id/w_pub"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:orientation="vertical" android:padding="9dp"
            android:background="@drawable/widget_card_pub">
            <TextView android:id="@+id/w_p_tag"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🚻 공중" android:textSize="10.5sp" android:textColor="#FFFFFF" android:textStyle="bold"
                android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="1dp" android:paddingBottom="1dp"
                android:background="@drawable/widget_tag_gray" />
            <TextView android:id="@+id/w_p_name"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:textSize="13sp" android:textColor="#2C2C2A" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_p_sub"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="#5F5E5A" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_p_pw"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                android:textSize="13sp" android:textColor="#5F5E5A" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_p_go"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="어플에서 길찾기" android:gravity="center" android:textSize="10.5sp" android:textColor="#2C2C2A" android:textStyle="bold"
                android:paddingTop="5dp" android:paddingBottom="5dp" android:background="@drawable/widget_btn_bg" />
        </LinearLayout>

        <!-- 제휴 가게 -->
        <LinearLayout android:id="@+id/w_ptn"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="3dp" android:orientation="vertical" android:padding="9dp"
            android:background="@drawable/widget_card_partner">
            <TextView android:id="@+id/w_t_tag"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🤝 제휴" android:textSize="10.5sp" android:textColor="#FFFFFF" android:textStyle="bold"
                android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="1dp" android:paddingBottom="1dp"
                android:background="@drawable/widget_tag_green" />
            <TextView android:id="@+id/w_t_name"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:textSize="13sp" android:textColor="#2C2C2A" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_t_sub"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="#5F5E5A" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_t_pw"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                android:textSize="13sp" android:textColor="#0F6E56" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_t_go"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="어플에서 길찾기" android:gravity="center" android:textSize="10.5sp" android:textColor="#2C2C2A" android:textStyle="bold"
                android:paddingTop="5dp" android:paddingBottom="5dp" android:background="@drawable/widget_btn_bg" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
